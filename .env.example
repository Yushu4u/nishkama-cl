# ==============================================================================
# NISHKAMA CODELAB (NCL) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure the variables below in Vercel Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL URL & DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.nishkamacodelab.com

# ------------------------------------------------------------------------------
# 2. CONTACT FORM — GOOGLE WORKSPACE SHEETS + EMAIL (Primary)
# ------------------------------------------------------------------------------
# Deployed Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
GOOGLE_CONTACT_WEBHOOK_URL=
# Shared secret token matching WEBHOOK_SECRET in docs/google-apps-script-contact.gs
GOOGLE_CONTACT_WEBHOOK_SECRET=
# Destination inbox inside Google Workspace
CONTACT_NOTIFICATION_EMAIL=hello@nishkamacodelab.com

# ------------------------------------------------------------------------------
# 3. PRIVACY-FIRST ANALYTICS & TELEMETRY (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Plausible Analytics domain (e.g. nishkamacodelab.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
