# ==============================================================================
# NISHKAMA CODELAB (NCL) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# None of these variables are required for the website to build and run.
# The site builds cleanly out of the box with safe production fallbacks.
# Configure the variables below in Vercel Project Settings > Environment Variables
# when you are ready to enable live email delivery or production analytics.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL URL & DOMAIN
# ------------------------------------------------------------------------------
# Custom production domain (used for SEO canonicals, sitemap.xml, OpenGraph).
# If omitted, defaults to https://nishkamacodelab.com or Vercel's preview URL.
NEXT_PUBLIC_SITE_URL=https://nishkamacodelab.com

# ------------------------------------------------------------------------------
# 2. CONTACT FORM EMAIL NOTIFICATIONS (Option A: Resend — Recommended)
# ------------------------------------------------------------------------------
# Get your API key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here
CONTACT_NOTIFICATION_EMAIL=hello@nishkamacodelab.com

# ------------------------------------------------------------------------------
# 2. CONTACT FORM EMAIL NOTIFICATIONS (Option B: SMTP)
# ------------------------------------------------------------------------------
# If you prefer traditional SMTP instead of Resend, configure these:
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Nishkama CodeLab <hello@nishkamacodelab.com>"

# ------------------------------------------------------------------------------
# 3. PRIVACY-FIRST ANALYTICS & TELEMETRY (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Plausible Analytics domain (e.g. nishkamacodelab.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
